{
  "cleanupPeriodDays": 14,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git describe*)",
      "Bash(git shortlog*)",
      "Bash(git grep*)",
      "Bash(git reflog)",
      "Bash(git branch)",
      "Bash(git branch -a*)",
      "Bash(git branch -v*)",
      "Bash(git branch --list*)",
      "Bash(git tag -l*)",
      "Bash(git stash list*)",
      "Bash(git remote -v)",
      "Bash(git config --get*)",
      "Bash(git config --list*)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:rust-lang.org)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:lib.rs)",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:swift.org)",
      "WebFetch(domain:swiftpackageindex.com)",
      "WebFetch(domain:nixos.org)",
      "WebFetch(domain:nix.dev)",
      "WebFetch(domain:nix-community.github.io)",
      "WebFetch(domain:nix-darwin.github.io)",
      "WebFetch(domain:kubernetes.io)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:helm.sh)",
      "WebFetch(domain:cluster-api.sigs.k8s.io)",
      "WebFetch(domain:opentofu.org)",
      "WebFetch(domain:developer.hashicorp.com)",
      "WebFetch(domain:docs.hetzner.com)",
      "WebFetch(domain:docs.hetzner.cloud)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:man7.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:git-scm.com)",
      "WebFetch(domain:warcraft.wiki.gg)",
      "WebFetch(domain:wowpedia.fandom.com)"
    ],
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git checkout*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm ci*)",
      "Bash(npm add*)",
      "Bash(npm update*)",
      "Bash(npm exec*)",
      "Bash(npx *)",
      "Bash(pnpm add*)",
      "Bash(pnpm install*)",
      "Bash(pnpm i *)",
      "Bash(pnpm dlx*)",
      "Bash(yarn add*)",
      "Bash(yarn install*)",
      "Bash(yarn dlx*)",
      "Bash(bun add*)",
      "Bash(bun install*)",
      "Bash(bun x *)",
      "Bash(bunx *)",
      "Bash(corepack *)",
      "Bash(nvm install*)",
      "Bash(volta install*)",
      "Bash(brew install *)",
      "Bash(sudo *)",
      "Bash(security find-*)",
      "Bash(security dump-keychain*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(**/kubeconfig*)",
      "Read(~/.config/k9s/**)",
      "Read(~/.config/cluster-api/**)",
      "Read(~/.config/helm/**)",
      "Read(~/.minikube/**)",
      "Read(~/.talos/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.docker/contexts/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.oci/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/hcloud/**)",
      "Read(~/.config/doctl/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gh-copilot/**)",
      "Read(~/.config/github-copilot/**)",
      "Read(~/.config/glab-cli/**)",
      "Read(~/.config/anthropic/**)",
      "Read(~/.config/sops/**)",
      "Read(~/.config/openfortivpn/**)",
      "Read(~/.config/filezilla/**)",
      "Read(~/.config/rclone/**)",
      "Read(~/.config/op/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.vault-token)",
      "Read(~/.terraform.d/**)",
      "Read(~/.password-store/**)",
      "Read(~/Library/Keychains/**)",
      "Read(**/*.kdbx)",
      "Read(~/.config/atuin/**)",
      "Read(~/.local/share/atuin/**)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.envrc)",
      "Read(**/*.tfvars)",
      "Read(**/terraform.tfstate*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.ppk)",
      "Read(**/*.age)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Edit(**/.git/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshenv)",
      "Edit(~/.bashrc)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/git/**)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/statusline.sh)",
      "Edit(~/.claude/hooks/**)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true
  },
  "model": "opus",
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 -I ~/.claude/hooks/block-secrets.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 -I ~/.claude/hooks/git-readonly.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 -I ~/.claude/hooks/scan-secrets.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 -I ~/.claude/hooks/webfetch-allowlist.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/audit-log.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "disableSkillShellExecution": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "design@synced": false,
    "engineering@synced": false,
    "cc-plugin-agents-md@builtin": false,
    "cc-plugin-diff@builtin": false,
    "cc-plugin-plugin-authoring@builtin": false,
    "cc-plugin-telemetry@builtin": false,
    "swift-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [],
      "deniedDomains": [
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "npm.pkg.github.com",
        "registry.npmmirror.com"
      ],
      "strictAllowlist": true
    },
    "filesystem": {
      "denyWrite": [
        "**/.git",
        "~/.zshrc",
        "~/.zprofile",
        "~/.zshenv",
        "~/.bashrc",
        "~/.gitconfig",
        "~/.config/git",
        "~/Library/LaunchAgents"
      ],
      "denyRead": [
        "~",
        "~/.ssh",
        "~/.gnupg",
        "~/.kube",
        "~/.config/k9s",
        "~/.config/cluster-api",
        "~/.config/helm",
        "~/.minikube",
        "~/.talos",
        "~/.docker",
        "~/.aws",
        "~/.azure",
        "~/.oci",
        "~/.config/gcloud",
        "~/.config/hcloud",
        "~/.config/doctl",
        "~/.config/gh",
        "~/.config/gh-copilot",
        "~/.config/github-copilot",
        "~/.config/glab-cli",
        "~/.config/anthropic",
        "~/.config/sops",
        "~/.config/openfortivpn",
        "~/.config/filezilla",
        "~/.config/rclone",
        "~/.config/op",
        "~/.git-credentials",
        "~/.netrc",
        "~/.npmrc",
        "~/.pypirc",
        "~/.cargo/credentials.toml",
        "~/.cargo/credentials",
        "~/.vault-token",
        "~/.terraform.d",
        "~/.password-store",
        "~/Library/Keychains",
        "~/.config/atuin",
        "~/.local/share/atuin",
        "~/.zsh_history",
        "~/.bash_history"
      ],
      "allowRead": [
        "~/code",
        "~/Documents/Master-Studium",
        "~/.claude",
        "~/.cargo/registry",
        "~/.cargo/git",
        "~/.cargo/bin",
        "~/.swiftpm",
        "~/Library/Developer",
        "~/Library/Caches",
        "~/.cache",
        "~/.nix-profile",
        "~/.local/state/nix",
        "~/.gitconfig",
        "~/.config/git"
      ],
      "allowWrite": [
        "/var/folders/y9/5b285mms4z5_dy6b4n4ymtf80000gn/C/clang/ModuleCache",
        "~/Library/Caches/org.swift.swiftpm",
        "~/Library/org.swift.swiftpm",
        "~/Library/Developer/Xcode/DerivedData",
        "/var/folders/y9/5b285mms4z5_dy6b4n4ymtf80000gn/T"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITLAB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "HCLOUD_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "SOPS_AGE_KEY",
          "mode": "deny"
        },
        {
          "name": "KUBECONFIG",
          "mode": "deny"
        }
      ]
    }
  },
  "feedbackDrafts": "off",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-or-agents-md"
      }
    }
  },
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "theme": "dark",
  "editorMode": "vim",
  "switchModelsOnFlag": true,
  "fileCheckpointingEnabled": true,
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Any git command that modifies a repository, its refs, index, config or remotes (commit, push, fetch, reset, checkout, stash, rebase, merge, tag creation, etc.)",
      "Reading, printing, copying or uploading credentials, private keys, kubeconfigs, docker auth, cloud provider config, .env files or shell history",
      "Installing node packages or running npx, pnpm dlx, yarn dlx, bunx or corepack",
      "Installing any additional software on the system",
      "Modifying ~/.claude settings, ~/.claude/hooks, the status line script, or shell rc files",
      "Working around a hook or sandbox block instead of reporting it to the user"
    ]
  },
  "_disabled_deny": [
    "Edit(~/.claude/settings.json)",
    "Edit(~/.claude/settings.local.json)",
    "Edit(~/.claude/statusline.sh)",
    "Edit(~/.claude/hooks/**)"
  ]
}
