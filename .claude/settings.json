{
  "cleanupPeriodDays": 14,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "LSP",
      "WebSearch",
      "mcp__plugin_context7_context7",
      "mcp__claude_ai_Context7",
      "Edit(~/.claude/projects/*/memory/**)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git describe*)",
      "Bash(git shortlog*)",
      "Bash(git grep*)",
      "Bash(git reflog)",
      "Bash(git branch)",
      "Bash(git branch -a*)",
      "Bash(git branch -v*)",
      "Bash(git branch --list*)",
      "Bash(git tag -l*)",
      "Bash(git stash list*)",
      "Bash(git remote -v)",
      "Bash(ls*)",
      "Bash(rg *)",
      "Bash(wc *)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:rust-lang.org)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:lib.rs)",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:swift.org)",
      "WebFetch(domain:swiftpackageindex.com)",
      "WebFetch(domain:nixos.org)",
      "WebFetch(domain:nix.dev)",
      "WebFetch(domain:nix-community.github.io)",
      "WebFetch(domain:nix-darwin.github.io)",
      "WebFetch(domain:kubernetes.io)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:helm.sh)",
      "WebFetch(domain:cluster-api.sigs.k8s.io)",
      "WebFetch(domain:opentofu.org)",
      "WebFetch(domain:developer.hashicorp.com)",
      "WebFetch(domain:docs.hetzner.com)",
      "WebFetch(domain:docs.hetzner.cloud)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:man7.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:git-scm.com)",
      "WebFetch(domain:warcraft.wiki.gg)",
      "WebFetch(domain:wowpedia.fandom.com)"
    ],
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git checkout*)",
      "Bash(sudo *)",
      "Bash(security find-*)",
      "Bash(security dump-keychain*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(**/kubeconfig*)",
      "Read(~/.config/k9s/**)",
      "Read(~/.config/cluster-api/**)",
      "Read(~/.config/helm/**)",
      "Read(~/.minikube/**)",
      "Read(~/.talos/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.docker/contexts/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.oci/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/hcloud/**)",
      "Read(~/.config/doctl/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gh-copilot/**)",
      "Read(~/.config/github-copilot/**)",
      "Read(~/.config/glab-cli/**)",
      "Read(~/.config/anthropic/**)",
      "Read(~/.config/sops/**)",
      "Read(~/.config/openfortivpn/**)",
      "Read(~/.config/filezilla/**)",
      "Read(~/.config/rclone/**)",
      "Read(~/.config/op/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.vault-token)",
      "Read(~/.terraform.d/**)",
      "Read(~/.password-store/**)",
      "Read(~/Library/Keychains/**)",
      "Read(**/*.kdbx)",
      "Read(~/.config/atuin/**)",
      "Read(~/.local/share/atuin/**)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.envrc)",
      "Read(**/*.tfvars)",
      "Read(**/terraform.tfstate*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.ppk)",
      "Read(**/*.age)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/.gradle/gradle.properties)",
      "Read(**/.m2/settings*.xml)"
    ],
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true
  },
  "model": "opus",
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 -I ~/.claude/hooks/audit.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 -I ~/.claude/hooks/audit.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 -I ~/.claude/hooks/audit.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "disableSkillShellExecution": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "design@synced": false,
    "engineering@synced": false,
    "cc-plugin-agents-md@builtin": false,
    "cc-plugin-diff@builtin": false,
    "cc-plugin-plugin-authoring@builtin": false,
    "cc-plugin-telemetry@builtin": false,
    "swift-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "docs.rs",
        "doc.rust-lang.org",
        "rust-lang.org",
        "crates.io",
        "lib.rs",
        "developer.apple.com",
        "swift.org",
        "swiftpackageindex.com",
        "nixos.org",
        "nix.dev",
        "nix-community.github.io",
        "nix-darwin.github.io",
        "kubernetes.io",
        "docs.docker.com",
        "helm.sh",
        "cluster-api.sigs.k8s.io",
        "opentofu.org",
        "developer.hashicorp.com",
        "docs.hetzner.com",
        "docs.hetzner.cloud",
        "github.com",
        "docs.github.com",
        "raw.githubusercontent.com",
        "docs.claude.com",
        "code.claude.com",
        "docs.anthropic.com",
        "developer.mozilla.org",
        "stackoverflow.com",
        "man7.org",
        "docs.python.org",
        "git-scm.com",
        "warcraft.wiki.gg",
        "wowpedia.fandom.com"
      ],
      "deniedDomains": [
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "npm.pkg.github.com",
        "registry.npmmirror.com"
      ],
      "strictAllowlist": true
    },
    "filesystem": {
      "denyWrite": [
        "~"
      ],
      "denyRead": [
        "~",
        "~/.ssh",
        "~/.gnupg",
        "~/.kube",
        "~/.config/k9s",
        "~/.config/cluster-api",
        "~/.config/helm",
        "~/.minikube",
        "~/.talos",
        "~/.docker",
        "~/.aws",
        "~/.azure",
        "~/.oci",
        "~/.config/gcloud",
        "~/.config/hcloud",
        "~/.config/doctl",
        "~/.config/gh",
        "~/.config/gh-copilot",
        "~/.config/github-copilot",
        "~/.config/glab-cli",
        "~/.config/anthropic",
        "~/.config/sops",
        "~/.config/openfortivpn",
        "~/.config/filezilla",
        "~/.config/rclone",
        "~/.config/op",
        "~/.git-credentials",
        "~/.netrc",
        "~/.npmrc",
        "~/.pypirc",
        "~/.cargo/credentials.toml",
        "~/.cargo/credentials",
        "~/.vault-token",
        "~/.terraform.d",
        "~/.password-store",
        "~/Library/Keychains",
        "~/.config/atuin",
        "~/.local/share/atuin",
        "~/.zsh_history",
        "~/.bash_history"
      ],
      "allowRead": [
        "~/code",
        "~/Documents/Master-Studium",
        "~/.claude",
        "~/.cargo/registry",
        "~/.cargo/git",
        "~/.cargo/bin",
        "~/.swiftpm",
        "~/Library/Developer",
        "~/Library/Caches",
        "~/.cache",
        "~/.nix-profile",
        "~/.local/state/nix",
        "~/.gitconfig",
        "~/.config/git"
      ]
    },
    "credentials": {
      "envVars": [
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GITLAB_TOKEN", "mode": "deny" },
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "OPENAI_API_KEY", "mode": "deny" },
        { "name": "AWS_ACCESS_KEY_ID", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" },
        { "name": "AWS_SESSION_TOKEN", "mode": "deny" },
        { "name": "HCLOUD_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "SOPS_AGE_KEY", "mode": "deny" },
        { "name": "KUBECONFIG", "mode": "deny" }
      ]
    }
  },
  "feedbackDrafts": "off",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-or-agents-md"
      }
    }
  },
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "theme": "dark",
  "editorMode": "vim",
  "switchModelsOnFlag": true
}
